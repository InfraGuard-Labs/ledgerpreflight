#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Observe the user's current PATH Java before selecting our private runtime.
# This does not alter PATH, JAVA_HOME, alternatives, or the running node.
if [ "${LP_HOST_JAVA_VERSION+x}" != x ]; then
  LP_HOST_JAVA_VERSION=NOT_INSTALLED
  if command -v java >/dev/null 2>&1; then
    LP_HOST_JAVA_VERSION=$(java -version 2>&1 | sed -n '1s/.*version "\([^"]*\)".*/\1/p' | head -c 128)
    [ -n "$LP_HOST_JAVA_VERSION" ] || LP_HOST_JAVA_VERSION=UNKNOWN
  fi
  export LP_HOST_JAVA_VERSION
fi
if [ -x "$HERE/runtime/bin/java" ]; then
  exec "$HERE/runtime/bin/java" -Dfile.encoding=UTF-8 -Xmx256m -jar "$HERE/ledger-preflight-0.1.0.jar" "$@"
fi
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  PREFLIGHT_JAVA="$JAVA_HOME/bin/java"
else
  PREFLIGHT_JAVA=java
fi
if ! "$PREFLIGHT_JAVA" -version >/dev/null 2>&1; then
  printf '%s\n' 'LedgerPreflight requires its bundled runtime or Java 17. Use the linux-x86_64 distribution; no system Java change is needed.' >&2
  exit 3
fi
PREFLIGHT_VERSION=$("$PREFLIGHT_JAVA" -version 2>&1 | sed -n '1s/.*version "\([^"]*\)".*/\1/p' | head -c 128)
PREFLIGHT_MAJOR=$(printf '%s' "$PREFLIGHT_VERSION" | sed 's/^1\.//; s/[._+-].*//')
case "$PREFLIGHT_MAJOR" in ""|*[!0-9]*) PREFLIGHT_MAJOR=0 ;; esac
if [ "$PREFLIGHT_MAJOR" -lt 17 ]; then
  printf '%s\n' 'The JAR-only package needs Java17. Use the linux-x86_64 package with its bundled runtime to assess this server without changing system Java.' >&2
  exit 3
fi
exec "$PREFLIGHT_JAVA" -Dfile.encoding=UTF-8 -Xmx256m -jar "$HERE/ledger-preflight-0.1.0.jar" "$@"
